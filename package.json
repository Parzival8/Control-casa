{
  "name": "control-casa",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "lint": "expo lint",
    "test": "jest",
    "doctor": "expo-doctor",
    "test:rules": "firebase emulators:exec --only firestore --project demo-control-casa \"jest -c jest.reglas.config.js --runInBand\""
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/auth": "^27.1.0",
    "@react-native-firebase/firestore": "^27.1.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react-native": "^14.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "firebase-tools": "^15.35.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/tests/reglas/"
    ]
